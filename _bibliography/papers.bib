@inproceedings{song2026ask,
abbr={EMNLP},
  title={Ask or Answer: A Decision Framework for Multi-Turn Health Misinformation Intervention},
  author={Song, Xiaoying and Anik, Anirban Saha and Liu, Jinyu and Tan, Qitao and Yuan, Geng and Hong, Lingzi},
  booktitle={Conference on Empirical Methods in Natural Language Processing},
  selected={true},
  year={2026},
  description={Proposes RO-PnR (Reward-Optimized Probe-and-Respond), which decides at each turn whether to probe for more information or commit to a final correction, guided by a turn-level reward weighing a probe's expected information gain against its interaction cost. Achieves the highest cost-adjusted utility across three health-misinformation datasets and three base models while using ~30% fewer turns than always-probe baselines.},
  keywords={health misinformation, multi-turn dialogue, clarifying questions, reward optimization}
}

