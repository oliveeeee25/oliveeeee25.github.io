---
layout: default
---
<div class="post about-home">
  <header class="home-hero">
    <div class="hero-copy">
      {% if page.eyebrow %}<p class="hero-eyebrow"><span></span>{{ page.eyebrow }}</p>{% endif %}
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          {{ site.first_name -}}
          {%- if site.middle_name %} {{ site.middle_name }}{% endif -%}
          {%- if site.last_name %} <em>{{ site.last_name }}</em>{% endif %}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      {% if page.role %}<p class="hero-role">{{ page.role }}</p>{% endif %}
      {% if page.intro %}<p class="hero-intro">{{ page.intro }}</p>{% endif %}

      <div class="hero-actions">
        <a class="home-button home-button-primary" href="{{ '/publications/' | relative_url }}">Explore my research <span aria-hidden="true">↗</span></a>
        <a class="home-button home-button-secondary" href="{{ '/cv/' | relative_url }}">View CV</a>
      </div>

      <div class="hero-meta" aria-label="Research profile details">
        <span><i class="ti ti-map-pin" aria-hidden="true"></i>Denton, Texas</span>
        <span><i class="ti ti-school" aria-hidden="true"></i>University of North Texas</span>
      </div>
    </div>

    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="hero-portrait">
        <div class="portrait-frame">
          {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 900px) 410px, 82vw" alt="Portrait of Xiaoying Song" cache_bust=true %}
        </div>
        <div class="portrait-note">
          <span>Researching</span>
          <strong>AI that works with people.</strong>
        </div>
      </div>
    {% endif %}
  </header>

  <article class="home-content">
    {{ content }}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section home-news" aria-labelledby="news-heading">
        <div class="section-heading section-heading-row">
          <div>
            <p class="section-kicker">Along the way</p>
            <h2 id="news-heading">Recent news</h2>
          </div>
          <a class="section-link" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section home-publications" aria-labelledby="publications-heading">
        <div class="section-heading section-heading-row">
          <div>
            <p class="section-kicker">Selected work</p>
            <h2 id="publications-heading">Publications</h2>
          </div>
          <a class="section-link" href="{{ '/publications/' | relative_url }}">View all papers <span aria-hidden="true">↗</span></a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <section class="home-contact" aria-labelledby="contact-heading">
        <div>
          <p class="section-kicker">Let’s connect</p>
          <h2 id="contact-heading">Curious minds are always welcome.</h2>
        </div>
        <div class="social">
          <div class="contact-note">{{ site.contact_note }}</div>
          <div class="contact-icons">{% include social.liquid %}</div>
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

  </article>
</div>
