---
layout: default
---
<div class="post home-page">
  <header class="post-header home-header">
    <p class="section-eyebrow">Language models &amp; human-centered AI</p>
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        {{ site.first_name -}}
        {%- if site.middle_name %} {{ site.middle_name }}{% endif -%}
        {%- if site.last_name %} {{ site.last_name }}{% endif %}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle and page.subtitle != blank %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article>
    <div class="about-intro">
      {% if page.introduction %}
        <div class="about-intro-text">{{ page.introduction | markdownify }}</div>
      {% endif %}
      {% if page.profile %}
        <div class="profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% assign profile_alt = site.first_name | append: ' ' | append: site.last_name %}
            {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 768px) 320px, 70vw" alt=profile_alt cache_bust=true %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="home-contact" aria-label="Research profiles">
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener"
        >Google Scholar <span aria-hidden="true">↗</span></a
      >
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/" target="_blank" rel="noopener"
        >LinkedIn <span aria-hidden="true">↗</span></a
      >
      <a href="{{ '/publications/' | relative_url }}">Publications <span aria-hidden="true">→</span></a>
    </div>

    {{ content }}

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section" aria-labelledby="news-heading">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">Recent updates</p>
            <h2 id="news-heading">News</h2>
          </div>
          <a class="section-link" href="{{ '/news/' | relative_url }}">All news <span aria-hidden="true">↗</span></a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section" aria-labelledby="posts-heading">
        <div class="section-heading">
          <h2 id="posts-heading">Latest posts</h2>
          <a class="section-link" href="{{ '/blog/' | relative_url }}">All posts <span aria-hidden="true">↗</span></a>
        </div>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section" aria-labelledby="publications-heading">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">Selected work</p>
            <h2 id="publications-heading">Publications</h2>
          </div>
          <a class="section-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

    <div class="visitor-map"><div id="mmvst_a"></div></div>
    <script>
      window.addEventListener('load', function () {
        var s = document.createElement('script');
        s.src = 'https://mapmyvisitors.com/globe.js?d=Ih8Y-aip4XnNuyv6kOfjzoVO7o6lbTZSY7MWJ7szIqI';
        document.body.appendChild(s);
      });
    </script>
  </article>
</div>
