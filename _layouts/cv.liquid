---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">Academic experience, publications, and research activities.</p>
  </header>
  <article>
    {% if page.cv_pdf %}
      {% if page.cv_pdf contains '://' %}
        {% assign cv_url = page.cv_pdf %}
      {% else %}
        {% assign cv_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      {% endif %}
      <div class="cv-pdf">
        <iframe src="{{ cv_url }}" title="Xiaoying Song’s curriculum vitae"></iframe>
      </div>
    {% endif %}
  </article>
</div>
